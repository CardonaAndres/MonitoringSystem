# ─── General ───
COMPOSE_PROJECT_NAME=monitoring
TZ=America/Bogota
NETWORK_NAME=monitoring-network

# ─── Grafana ───
GRAFANA_PORT=4000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# ─── cAdvisor ───
# Cambiar si el 8080 ya está en uso en el host (ej. otro servicio en prod)
CADVISOR_PORT=8080

# ─── Reverse proxy / dominio (solo VPS, perfil "proxy") ───
# Dominio con registro A apuntando a la IP del VPS. Caddy emite el
# certificado TLS automático (Let's Encrypt) para este dominio.
DOMAIN=grafana.tudominio.com

# ─── Alertmanager notifications ───
# Webhook de Discord para alertas (dejar vacío para desactivar Discord)
DISCORD_ALERTS_WEBHOOK=
ALERT_TITLE_PREFIX=[Monitoring]

# Notificaciones por correo (dejar vacío para desactivar email)
# Ej. Gmail: smarthost=smtp.gmail.com:587, user=tu-correo@gmail.com,
# password = App Password (no la contraseña normal de la cuenta)
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=alerts@example.com
SMTP_AUTH_USERNAME=
SMTP_AUTH_PASSWORD=

# Destinatarios separados por coma
ALERT_EMAIL_TO=
